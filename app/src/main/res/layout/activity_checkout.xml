<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/light_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete Your Payment"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/nav_selected_color"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <!-- Order Summary Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Summary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/nav_selected_color"
                    android:layout_marginBottom="16dp" />

                <!-- Order Total -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Amount:"
                        android:textSize="18sp"
                        android:textColor="@color/textColorPrimary" />
                        
                    <TextView
                        android:id="@+id/display_total_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal_200" />
                </LinearLayout>

                <!-- Security Notice -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp"
                    android:padding="8dp"
                    android:background="@color/light_gray">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 Secured by Stripe"
                        android:textSize="14sp"
                        android:textColor="@color/textColorSecondary" />
                </LinearLayout>
                
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Payment Method Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Method"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/nav_selected_color"
                    android:layout_marginBottom="16dp" />

                <!-- Simple Card Input Fields (Fallback) -->
                <LinearLayout
                    android:id="@+id/simple_card_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    
                    <EditText
                        android:id="@+id/card_number_input"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Card Number (e.g. 4242 4242 4242 4242)"
                        android:inputType="number"
                        android:maxLength="23"
                        android:layout_marginBottom="8dp"
                        android:padding="12dp"
                        android:textSize="16sp"
                        android:background="@drawable/edit_text_background" />
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        
                        <EditText
                            android:id="@+id/expiry_input"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:hint="MM/YY"
                            android:inputType="number"
                            android:maxLength="5"
                            android:layout_marginEnd="8dp"
                            android:padding="12dp"
                            android:textSize="16sp"
                            android:background="@drawable/edit_text_background" />
                        
                        <EditText
                            android:id="@+id/cvc_input"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:hint="CVC"
                            android:inputType="number"
                            android:maxLength="4"
                            android:padding="12dp"
                            android:textSize="16sp"
                            android:background="@drawable/edit_text_background" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card Security Info -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your payment information is encrypted and secure. We do not store your card details."
                    android:textSize="12sp"
                    android:textColor="@color/textColorSecondary"
                    android:gravity="center"
                    android:padding="8dp"
                    android:background="@color/light_gray" />
                
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pay Button -->
        <Button
            android:id="@+id/payButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Pay Now"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/nav_selected_color"
            android:elevation="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Processing indicator (initially hidden) -->
        <LinearLayout
            android:id="@+id/processing_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:padding="16dp">
            
            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Processing payment..."
                android:textSize="16sp"
                android:textColor="@color/textColorPrimary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
